# Clave gratuita de desarrollador INEGI. Sin ella el conteo DENUE no entra al score.
# https://www.inegi.org.mx/servicios/api_denue.html
INEGI_TOKEN=

# Clave SAKBÉ, distinta de la de DENUE. Se pide con nombre y correo.
# https://gaia.inegi.org.mx/sakbe_v3.1/genera_token.jsp
SAKBE_TOKEN=


# El Oráculo (POST /api/oracle). Dormido por defecto: sin clave responde 503.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Vacío usa claude-opus-5-5. Si se fija, ID completo de la tabla vigente, sin alias.
ATLAS_ORACLE_MODEL=
