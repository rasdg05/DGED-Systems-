# Agente a la medida (services/agente). Todas vacías: el agente nace dormido.

# Raíz de los espacios por cliente (vacío = datos/espacios). Un cliente, una carpeta.
AGENTE_DATOS=

# Secreto del que sale la llave de cada cliente (X-Tenant-Key, MCP). Sin él no abre ningún espacio.
TENANT_INTERNAL_TOKEN=

# Tope de gasto de API por cliente y mes en USD si su config.json no trae otro. Vacío = 0: no gasta.
TENANT_TOPE_USD_MES=

# Sin clave el agente no redacta: todo pasa a la persona.
ANTHROPIC_API_KEY=
# Vacío usa claude-haiku-5-5 para los turnos de rutina.
AGENTE_MODELO_RUTINA=

# WhatsApp Cloud API (vía oficial, coexistencia de Meta). Sin token el agente no envía nada.
WHATSAPP_TOKEN=
# Firma de los webhooks (X-Hub-Signature-256). Sin él no entra ningún webhook.
WHATSAPP_APP_SECRET=
# Lo que Meta manda al verificar el webhook.
WHATSAPP_VERIFY_TOKEN=
# Vacío usa v23.0.
WHATSAPP_GRAPH_VERSION=
